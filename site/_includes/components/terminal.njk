<span class="t-dim">│</span>                               <span class="t-pri">FLUX CORE MATRIX</span>                               <span class="t-dim">│</span>
<span class="t-dim">├──────────────────────────────────────────────────────────────────────────────┤</span>
<span class="t-dim">│</span> <span class="t-sec">[SRC] raw_footage.mkv</span><span class="t-dim">  ──▶  </span><span class="t-pri">[HW] Nvidia</span><span class="t-dim">  ──▶  </span><span class="t-suc">[OUT] hevc_nvenc</span>               <span class="t-dim">│</span>
