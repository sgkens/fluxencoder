  ]
}) }}

{{ callout({
  kind: "note",
  title: "EXPLICITLY UNMEASURED METRICS",
  body: "<p><strong>GPU utilization and GPU VRAM</strong> are intentionally omitted. Because there is no portable, unprivileged API to read per-process GPU load across NVIDIA, AMD, Intel, and Apple Silicon drivers, FluxEncoder refuses to fabricate or guess figures it cannot measure. Likewise, <code>cpu_percent</code> measures the child FFmpeg process alone and stays <code>NULL</code> on the initial sample (since CPU rate requires two readings).</p>"
}) }}

<h2>Deleting Stored Data</h2>

{{ terminalFrame({
  title: "bash — pruning or removing local history",
  stream: "stdout",
  exitCode: 0,
  code: "# Delete all recorded runs and telemetry samples
flux history clear

# Delete runs older than 30 days
flux history clear --older-than 30

# Remove history database and cache directory completely (Linux)
rm -rf ~/.local/share/fluxencoder ~/.cache/fluxencoder"
}) }}
