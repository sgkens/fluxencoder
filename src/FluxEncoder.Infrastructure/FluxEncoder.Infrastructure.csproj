<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Required by the source-generated P/Invoke (LibraryImport) for Windows Credential Manager. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trim and NativeAOT analyzers run on every build: docs/adr/0003-release-artifact-policy.md -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FluxEncoder.Core/FluxEncoder.Core.csproj" />
  </ItemGroup>
</Project>
